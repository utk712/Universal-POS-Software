{
  "name": "vyaparflow-pos-app",
  "version": "1.0.0",
  "main": "main.js",

  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },

  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },

  "dependencies": {},

  "build": {
    "appId": "com.vyaparflow.pos",
    "productName": "VyaparFlow POS & ERP",

    "directories": {
      "output": "dist"
    },

    "files": [
      "**/*",
      "!dist/*"
    ],

    "extraResources": [
      {
        "from": "../client/build",
        "to": "client/build"
      },
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!backup",
          "!*.log"
        ]
      }
    ],

    "asar": true,

    "asarUnpack": [
      "server/**/*"
    ],

    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    }
  }
}